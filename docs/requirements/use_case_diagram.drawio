nt="1"><mxGeometry x="400" y="1265" width="1000" height="200" as="geometry"/></mxCell><mxCell id="m5" value="M5 · Đo lường (E5)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;fillColor=#fcfcfc;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="400" y="1485" width="1000" height="100" as="geometry"/></mxCell><mxCell id="uc01" value="&lt;b&gt;UC-01&lt;/b&gt;&lt;br&gt;Đăng nhập" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="138" width="220" height="60" as="geometry"/></mxCell><mxCell id="uc02" value="&lt;b&gt;UC-02&lt;/b&gt;&lt;br&gt;Xác thực danh tính" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="105" width="220" height="60" as="geometry"/></mxCell><mxCell id="uc03" value="&lt;b&gt;UC-03&lt;/b&gt;&lt;br&gt;Kiểm tra quyền truy cập" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="180" width="220" height="60" as="geometry"/></mxCell><mxCell id="uc11" value="&lt;b&gt;UC-11&lt;/b&gt;&lt;br&gt;Xem nhật ký tài liệu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="220" height="60" as="geometry"/></mxCell><mxCell id="uc04" value="&lt;b&gt;UC-04&lt;/b&gt;&lt;br&gt;Tải lên tài liệu PDF" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="400" width="220" height="60" as="geometry"/></mxCell><mxCell id="uc10" value="&lt;b&gt;UC-10&lt;/b&gt;&lt;br&gt;Gỡ tài liệu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="505" width="220" height="60" as