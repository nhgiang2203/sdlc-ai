l><mxCell id="as_u2" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="a_user" target="uc10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as_u3" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="a_user" target="uc08"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as_u4" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="a_user" target="uc12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as_u5" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="a_user" target="uc21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as_u6" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="a_user" target="uc22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as_lead" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="a_lead" target="uc11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as_mgr" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="a_mgr" target="uc24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as_idp" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="uc02" target="a_idp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="as_ai" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;" edge="1" parent="1" source="uc13" target="a_ai"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc0" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc01" target="uc02"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc1" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc01" target="uc03"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc2" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc04" target="uc06"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc3" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc04" target="uc07"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc4" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc12" target="uc13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc5" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc13" target="uc14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="inc6" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc22" target="uc23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ext0" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc05" target="uc04"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ext1" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc09" target="uc08"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ext2" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc16" target="uc12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ext3" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc17" target="uc12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ext4" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc18" target="uc12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ext5" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc19" target="uc12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ext6" value="«extend»" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc20" target="uc12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ext7" value="«extend»&lt;br&gt;[không có thông tin trong phạm vi]" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc15" target="uc13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Chú giải (UML 2.0)&lt;/b&gt;&lt;br&gt;● Ô xanh: use case người dùng tương tác trực tiếp&lt;br&gt;● Ô xám: use case được include / extend&lt;br&gt;● ── nét liền: association (actor – use case)&lt;br&gt;● ╌╌▷ «include»: hành vi bắt buộc, mũi tên từ use case gốc&lt;br&gt;● ╌╌▷ «extend»: hành vi tuỳ chọn/có điều kiện, mũi tên về use case gốc&lt;br&gt;● ──▷ tam giác rỗng: generalization (actor con → actor cha)&lt;br&gt;&lt;br&gt;&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;1. Chuyên viên BD, Trưởng nhóm BD, Quản lý kế thừa mọi use case của &lt;i&gt;Người dùng được cấp quyền&lt;/i&gt; (BRU-003). Tải lên và gỡ tài liệu dành cho mọi người dùng được cấp quyền theo BR-001, BR-003.&lt;br&gt;2. Vai trò Quản lý (UC-24) được gán theo OQ-026; nguồn định danh theo OQ-016 / DEP-004.&lt;br&gt;3. UC-15 thay cho câu trả lời khi tài liệu trong phạm vi không có thông tin (BR-009).&lt;br&gt;4. Nguồn: BRD-CWD-001 v0.2, PRD-CWD-001 v0.1." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="1080" width="440" height="330" as="geometry"/></mxCell><mxCell id="trace" value='&lt;b&gt;Truy vết Use case → PRD → BRD&lt;/b&gt;&lt;table border="1" cellpadding="2" style="border-collapse:collapse;font-size:10px;width:100%;margin-top:4px"&gt;&lt;tr style="background:#eeeeee"&gt;&lt;th&gt;Use case&lt;/th&gt;&lt;th&gt;PRD&lt;/th&gt;&lt;th&gt;BRD&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-01..03&lt;/td&gt;&lt;td&gt;US-001&lt;/td&gt;&lt;td&gt;BR-018&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-04&lt;/td&gt;&lt;td&gt;US-002&lt;/td&gt;&lt;td&gt;BR-001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-05&lt;/td&gt;&lt;td&gt;US-006&lt;/td&gt;&lt;td&gt;BR-005&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-06&lt;/td&gt;&lt;td&gt;US-004&lt;/td&gt;&lt;td&gt;BR-004&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-07&lt;/td&gt;&lt;td&gt;US-002, NFR-005&lt;/td&gt;&lt;td&gt;BR-001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-08&lt;/td&gt;&lt;td&gt;US-003&lt;/td&gt;&lt;td&gt;BR-002&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-09&lt;/td&gt;&lt;td&gt;US-003&lt;/td&gt;&lt;td&gt;BR-002&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-10&lt;/td&gt;&lt;td&gt;US-005&lt;/td&gt;&lt;td&gt;BR-003&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-11&lt;/td&gt;&lt;td&gt;US-007&lt;/td&gt;&lt;td&gt;BR-019&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-12&lt;/td&gt;&lt;td&gt;US-008&lt;/td&gt;&lt;td&gt;BR-006&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-13&lt;/td&gt;&lt;td&gt;US-009, US-012&lt;/td&gt;&lt;td&gt;BR-007, BR-010&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-14&lt;/td&gt;&lt;td&gt;US-010&lt;/td&gt;&lt;td&gt;BR-008&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-15&lt;/td&gt;&lt;td&gt;US-011&lt;/td&gt;&lt;td&gt;BR-009&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-16&lt;/td&gt;&lt;td&gt;US-013&lt;/td&gt;&lt;td&gt;BR-011&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-17&lt;/td&gt;&lt;td&gt;US-014, US-015&lt;/td&gt;&lt;td&gt;BR-012, BR-013&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-18&lt;/td&gt;&lt;td&gt;US-008&lt;/td&gt;&lt;td&gt;BR-006&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-19&lt;/td&gt;&lt;td&gt;UX-09&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-20&lt;/td&gt;&lt;td&gt;US-021&lt;/td&gt;&lt;td&gt;BR-022&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-21&lt;/td&gt;&lt;td&gt;US-016&lt;/td&gt;&lt;td&gt;BR-017&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-22&lt;/td&gt;&lt;td&gt;US-017&lt;/td&gt;&lt;td&gt;BR-016&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-23&lt;/td&gt;&lt;td&gt;US-018&lt;/td&gt;&lt;td&gt;BR-024&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;UC-24&lt;/td&gt;&lt;td&gt;US-019, US-020&lt;/td&gt;&lt;td&gt;BR-021, BR-025&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1470" y="1430" width="440" height="480" as="geometry"/></mxCell><mxCell id="title" value='&lt;b&gt;Sơ đồ Use Case — Chat với tài liệu (MVP)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;UML 2.0 · Phiên bản 0.1 · 2026-10-20 · Nguồn: BRD v0.2, PRD v0.1&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1470" y="30" width="440" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
